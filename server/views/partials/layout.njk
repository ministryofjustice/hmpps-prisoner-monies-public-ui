{% extends "govuk/template.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block head %}
  <link href="{{ '/assets/css/index.css' | assetMap }}" rel="stylesheet"/>
{% endblock %}

{% block pageTitle %}{{pageTitle | default(applicationName)}}{% endblock %}
{% set htmlLang = locale | default('en-gb')  %}

{% block header %}
{% include "./header.njk" %}
{{ govukServiceNavigation({
  serviceName: t("common.serviceName"),
  serviceUrl: localePath('/')
}) }}
{% endblock %}

{% block beforeContent %}
<div class="govuk-phase-banner">
  <p class="govuk-phase-banner__content">
      {% if environmentName %}
        {{ govukTag({
          text: environmentName,
          classes: "govuk-phase-banner__content__tag " + environmentNameColour,
          attributes: { "data-qa": "header-phase-banner" }
        }) }}
      {% endif %}
      <span class="govuk-phase-banner__text">
        <a class="govuk-link" href="{{localePath('/help/')}}">Contact us</a> if you need help or would like to give us some feedback.
      </span>
  </p>
</div>
{% if backLinkHref %}
{{ govukBackLink({ href: backLinkHref }) }}
{% endif %}
{% endblock %}

{% block bodyStart %}
{% endblock %}

{% block bodyEnd %}
<script type="module" src="{{ '/assets/js/index.js' | assetMap }}"></script>
{% endblock %}
