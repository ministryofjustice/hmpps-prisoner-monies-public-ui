{% extends "../partials/layout-two-thirds.njk" %}

{% set pageTitle = t("paymentChoice.pageHeading") + " - " + applicationName %}
{% set mainClasses = "govuk-body" %}

{% block page_content %}

    <header>
      <h1 class="govuk-heading-xl">{{ t("paymentChoice.pageHeading") }}</h1>
    </header>

    <p class="govuk-body-l">
      {{ t("paymentChoice.intro") }}
    </p>

    {% if serviceAvailable %}

    <p class="govuk-body">
      {{ t("paymentChoice.body1") }}
      {{ t("paymentChoice.body2") }}
    </p>

    <p class="govuk-body">
      {{ t("paymentChoice.body3") }}
    </p>

    <p class="govuk-body">
      {{ t("paymentChoice.body4") }}
    </p>

    <a id="id_debit_card" class="govuk-button" data-module="govuk-button" href="{{continueUrl}}">
      {{ t("paymentChoice.continue") }}
    </a>

    {% else %}

    <div class="govuk-error-summary" aria-labelledby="service-unavailable-heading" role="alert" data-module="govuk-error-summary">
      <h2 class="govuk-error-summary__title" id="service-unavailable-heading">
        {{ serviceUnavailableMessage or t("paymentChoice.serviceUnavailableHeading") }}
      </h2>
      <div class="govuk-error-summary__body">
        <p class="govuk-body">
          {{ t("paymentChoice.serviceUnavailableBody") }}
        </p>
      </div>
    </div>

    {% endif %}

{% endblock %}
