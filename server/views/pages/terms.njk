{% extends "../partials/layout.njk" %}

{% set pageTitle = t("terms.pageTitle") + " - " + applicationName %}
{% set mainClasses = "govuk-body" %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-xl">{{ t("terms.pageTitle") }}</h1>

      <p class="govuk-body">{{ t("terms.intro1") }} {{ t("terms.intro2") }}</p>

      <h2 class="govuk-heading-s">{{ t("terms.purposeHeading") }}</h2>
      <p class="govuk-body">
        {{ t("terms.purpose1") }}
        {{ t("terms.purpose2") }}
        {{ t("terms.purpose3") }}
      </p>
      <p class="govuk-body">
        {{ t("terms.update1") }}
        {{ t("terms.update2") }}
        {{ t("terms.update3") }}
      </p>
      <p class="govuk-body">{{ t("terms.disagree") }}</p>

      <h2 class="govuk-heading-s">{{ t("terms.paymentsHeading") }}</h2>
      <p class="govuk-body">
        {{ t("terms.payments1") }}
        {{ t("terms.payments1b") }}
      </p>
      <p class="govuk-body">
        {{ t("terms.payments2") }}
        {{ t("terms.payments2b") }}
      </p>
      <p class="govuk-body">{{ t("terms.payments3") }}</p>
      <p class="govuk-body">{{ t("terms.payments4") }}</p>
      <p class="govuk-body">{{ t("terms.payments5") }}</p>

      <h2 class="govuk-heading-s">{{ t("terms.lawHeading") }}</h2>
      <p class="govuk-body">{{ t("terms.law1") }}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>Computer Misuse Act 1990</li>
        <li>Data Protection Act 2018</li>
        <li>Mental Capacity Act 2005</li>
        <li>Proceeds of Crime Act 2002</li>
        <li>Terrorism Act 2000</li>
      </ul>

      <h2 class="govuk-heading-s">{{ t("terms.responsibleHeading") }}</h2>
      <p class="govuk-body">
        {{ t("terms.responsible1") }}
        {{ t("terms.responsible2") }}
        {{ t("terms.responsible3") }}
        {{ t("terms.responsible4") }}
      </p>
      <p class="govuk-body">
        {{ t("terms.responsible5") }}
        {{ t("terms.responsible6") }}
      </p>
      <p class="govuk-body">
        {{ t("terms.responsible7a") }}
        {{ t("terms.responsible7b") }}
      </p>

      <h2 class="govuk-heading-s">{{ t("terms.feedbackHeading") }}</h2>
      <p class="govuk-body">{{ t("terms.feedback1Html") | safe }}</p>

      <h2 class="govuk-heading-s">{{ t("terms.disclaimerHeading") }}</h2>
      <p class="govuk-body">
        {{ t("terms.disclaimer1") }}
        {{ t("terms.disclaimer2") }}
        {{ t("terms.disclaimer3") }}
      </p>
      <p class="govuk-body">{{ t("terms.disclaimer4") }}</p>

    </div>
  </div>

{% endblock %}
