{% extends "../partials/layout.njk" %}

{% set pageTitle = t("beforeYouContinue.pageTitle") + " - " + applicationName %}
{% set mainClasses = "govuk-body" %}

{% block content %}

<div class="app-user-agreement">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="app-user-agreement__contents">

        <h1 class="govuk-heading-xl">{{ t("beforeYouContinue.pageTitle") }}</h1>

        <p class="govuk-body-l">
          {{ t("beforeYouContinue.intro1") }}
        </p>
        <p class="govuk-body-l">
          {{ t("beforeYouContinue.intro2") }}
          <a class="govuk-link" href="{{ localePath('/terms') }}">{{ t("beforeYouContinue.termsLink") }}</a> {{ t("beforeYouContinue.and") }}
          <a class="govuk-link" href="{{ localePath('/privacy') }}">{{ t("beforeYouContinue.privacyLink") }}</a>
        </p>

        <a id="id_next_btn" class="govuk-button" data-module="govuk-button" href="{{ continueUrl }}">{{ t("beforeYouContinue.continue") }}</a>

      </div>
    </div>
  </div>
</div>

{% endblock %}
